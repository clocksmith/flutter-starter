  ],
  "compositionFrameworkSymbols": [
    "BuildContext",
    "Widget",
    "StatelessWidget",
    "StatefulWidget",
    "State",
    "Key",
    "ValueKey",
    "VoidCallback",
    "ValueChanged",
    "TextEditingController",
    "FocusNode",
    "ScrollController",
    "WidgetBuilder",
    "MaterialApp",
    "Locale",
    "Navigator",
    "MaterialPageRoute",
    "ScaffoldMessenger",
    "KeyedSubtree",
    "Builder",
