{
  "layers": {
    "core": {
      "paths": [
        "^packages/core/lib/"
      ],
      "dependsOn": [
        "core"
      ],
      "packages": []
    },
    "ui": {
      "paths": [
        "^packages/ui/lib/"
      ],
      "dependsOn": [
        "ui"
      ],
      "packages": [
        "flutter/material.dart",
        "flutter/widgets.dart",
        "flutter/foundation.dart"
      ]
    },
    "domain": {
      "paths": [
        "^example/lib/features/[^/]+/domain/"
      ],
      "dependsOn": [
        "core",
        "domain"
      ],
      "packages": []
    },
    "application": {
      "paths": [
        "^example/lib/features/[^/]+/application/",
        "^example/lib/application/"
      ],
      "dependsOn": [
        "core",
        "domain",
        "application"
      ],
      "packages": []
    },
    "infrastructure": {
      "paths": [
        "^example/lib/features/[^/]+/infrastructure/",
        "^example/lib/infrastructure/"
      ],
      "dependsOn": [
        "core",
        "domain",
        "infrastructure"
      ],
      "packages": [
        "flutter/services.dart",
        "flutter/foundation.dart"
      ],
      "deviceAccess": true
    },
    "presentation": {
      "paths": [
        "^example/lib/features/[^/]+/presentation/"
      ],
      "dependsOn": [
        "core",
        "ui",
        "domain",
        "application",
        "presentation",
        "l10n"
      ],
      "packages": [
        "flutter/widgets.dart",
        "flutter_hooks/flutter_hooks.dart",
        "flutter_riverpod/flutter_riverpod.dart"
      ]
    },
    "composition": {
      "paths": [
        "^example/lib/app/",
        "^example/lib/main.dart$"
      ],
      "dependsOn": [
        "core",
        "ui",
        "domain",
        "application",
        "infrastructure",
        "presentation",
        "composition",
        "design",
        "l10n"
      ],
      "packages": [
        "flutter/material.dart",
        "flutter/widgets.dart",
        "flutter_localizations/flutter_localizations.dart",
        "flutter_riverpod/flutter_riverpod.dart"
      ]
    },
    "design": {
      "paths": [
        "^example/lib/design_system/"
      ],
      "dependsOn": [
        "ui",
        "design"
      ],
      "packages": [
        "flutter/material.dart",
        "flutter/widgets.dart",
        "flutter/foundation.dart"
      ]
    },
    "l10n": {
      "paths": [
        "^example/lib/l10n/"
      ],
      "dependsOn": [
        "core",
        "l10n"
      ],
      "packages": []
    }
  },
  "dartLibraries": [
    "async",
    "collection",
    "convert",
    "core",
    "math",
    "typed_data"
  ],
  "deviceLibraries": [
    "io",
    "ffi",
    "isolate",
    "html",
    "js",
    "js_interop",
    "js_util"
  ],
  "workspacePackages": {
    "core": "packages/core/lib/",
    "ui": "packages/ui/lib/",
    "starter_example": "example/lib/"
  },
  "publicEntries": {
    "core": "core.dart",
    "ui": "ui.dart"
  },
  "presentationFrameworkSymbols": [
    "BuildContext",
    "Widget",
    "StatelessWidget",
    "StatefulWidget",
    "State",
    "Key",
    "ValueKey",
    "VoidCallback",
    "ValueChanged",
    "TextEditingController",
    "FocusNode",
    "ScrollController",
    "WidgetBuilder"
  ],
  "visualSymbols": [
    "Color",
    "Colors",
    "ColorScheme",
    "TextStyle",
    "Theme",
    "ThemeData",
    "ThemeExtension",
    "TextTheme",
    "EdgeInsets",
    "EdgeInsetsDirectional",
    "BorderRadius",
    "BorderRadiusDirectional",
    "Border",
    "BorderSide",
    "BoxDecoration",
    "BoxShadow",
    "ShapeDecoration",
    "Decoration",
    "FontWeight",
    "FontStyle",
    "Alignment",
    "AlignmentDirectional",
    "Curves",
    "Curve",
    "AnimationController",
    "AnimatedContainer",
    "AnimatedOpacity",
    "Tween",
    "Container",
    "Padding",
    "SizedBox",
    "ConstrainedBox",
    "BoxConstraints",
    "Column",
    "Row",
    "Wrap",
    "Stack",
    "Align",
    "Center",
    "Text",
    "RichText",
    "Icon",
    "Icons",
    "Card",
    "Scaffold",
    "AppBar",
    "TextField",
